# Khi deploy, copy file này thành .env (cùng thư mục docker-compose.prod.yml), rồi điền giá trị thật.
# File .env đã được .gitignore bỏ qua bởi rule .env có sẵn.

# Domain thật đã trỏ A record về IP VPS
DOMAIN=your-domain.com
# Email nhận thông báo Let's Encrypt
ACME_EMAIL=you@example.com

# Thông tin Postgres (db service tạo, backend dùng lại qua override)
POSTGRES_DB=StudyEnglishWithNhu
POSTGRES_USER=englishweb
POSTGRES_PASSWORD=change_me_strong

# Build-time cho FE (Vite bake lúc build). Vì gộp 1 domain, API cùng origin:
VITE_API_BASE_URL=https://your-domain.com
VITE_GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
VITE_FACEBOOK_APP_ID=your_facebook_app_id
